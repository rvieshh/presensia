# Database
DATABASE_URL="postgresql://presensia:CHANGE_ME@127.0.0.1:5432/presensia?schema=public"

# Secrets — generate each independently:
# openssl rand -base64 48
JWT_SECRET="CHANGE_ME_RANDOM_JWT_SECRET"
QR_SECRET="CHANGE_ME_RANDOM_QR_SECRET"

# First administrator (used by `npm run seed`)
ADMIN_NAME="Administrator"
ADMIN_EMAIL="admin@example.sch.id"
ADMIN_PASSWORD="CHANGE_ME_MINIMUM_12_CHARS"
ADMIN_SESSION_MINUTES="60"
TOTP_ENCRYPTION_KEY="CHANGE_ME_RANDOM_TOTP_ENCRYPTION_KEY"
SCHOOL_NAME="Nama Sekolah"

# Optional scanner device bootstrap. Leave blank to create it later.
# Generate with: openssl rand -hex 32
DEVICE_API_KEY=""
DEVICE_NAME="Scanner Utama"
DEVICE_LOCATION="Gerbang Utama"

# Runtime
NODE_ENV="production"
PORT="3900"
HOST="0.0.0.0"

# Cookie on direct HTTP must remain false. Behind HTTPS/nginx set true.
COOKIE_SECURE="false"

# Optional WhatsApp worker fallback; admin settings can also store these.
WA_GATEWAY_URL=""
WA_GATEWAY_TOKEN=""
